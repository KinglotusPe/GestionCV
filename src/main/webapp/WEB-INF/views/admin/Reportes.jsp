<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="../common/header.jsp" %>
<%@ taglib prefix="display" uri="http://displaytag.sf.net" %>
<section class="portal-panel"><h1 class="h4">Reportes de bolsa laboral</h1>
<form method="get" class="row g-3 no-print mb-4"><div class="col-lg-4"><label class="form-label" for="kind">Reporte</label><select id="kind" name="kind" class="form-select"><option value="jobs" ${kind == 'jobs' ? 'selected' : ''}>Convocatorias registradas</option><option value="companies" ${kind == 'companies' ? 'selected' : ''}>Postulantes por empresa</option><option value="careers" ${kind == 'careers' ? 'selected' : ''}>Postulantes por carrera</option><option value="applicants" ${kind == 'applicants' ? 'selected' : ''}>Listado de postulantes</option></select></div><div class="col-lg-3"><label class="form-label" for="start">Desde</label><input id="start" name="start" type="date" class="form-control" value="<c:out value='${start}'/>" required></div><div class="col-lg-3"><label class="form-label" for="end">Hasta</label><input id="end" name="end" type="date" class="form-control" value="<c:out value='${end}'/>" required></div><div class="col-lg-2 align-self-end"><button class="btn btn-success">Generar reporte</button></div><div class="col-12"><button class="btn btn-outline-success" name="format" value="xlsx">Exportar Excel</button> <button class="btn btn-outline-secondary" type="button" data-print>Imprimir / guardar PDF</button></div></form>
<p>Periodo: <strong><c:out value="${start}"/></strong> al <strong><c:out value="${end}"/></strong>.</p><p class="small text-muted">Convocatorias: fecha de registro. Postulaciones: fecha de envío. Los conteos por empresa y carrera excluyen postulaciones retiradas y cuentan candidatos únicos; el listado conserva el historial.</p>
<c:choose><c:when test="${empty rows}"><p class="alert alert-info">No hay resultados para este periodo.</p></c:when><c:otherwise><div class="table-responsive"><display:table name="requestScope.rows" id="reportRow" pagesize="${param.print == 'yes' ? 0 : 20}" requestURI="" class="table table-bordered table-striped" excludedParams="format print">
<c:forEach var="column" items="${rows[0]}"><display:column property="${column.key}" title="${column.key}" sortable="true" escapeXml="true"/></c:forEach>
<display:setProperty name="basic.msg.empty_list" value="No hay resultados."/>
<display:setProperty name="paging.banner.placement" value="bottom"/>
</display:table></div></c:otherwise></c:choose></section>
<%@ include file="../common/footer.jsp" %>
