<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="../common/header.jsp" %>
<section class="portal-panel"><h1 class="h4">Empresas y solicitudes</h1><p class="text-muted">Revise las cuentas registradas y deje constancia de cada decisión.</p><hp:notice message="Cada decisión guarda el estado y su sustento en una sola operación."/>
<p>Enlace de registro: <a href="${pageContext.request.contextPath}/register">Registro de egresados y empresas</a></p>
<div class="table-responsive"><table class="table table-bordered table-striped portal-table" data-local-table><thead><tr><th>Empresa / RUC</th><th>Correo</th><th>Estado</th><th>Revisión</th></tr></thead><tbody>
<c:forEach var="e" items="${companies}"><tr data-company-id="${e.company_id}"><td><strong><c:out value="${e.company_name}"/></strong><br><c:out value="${e.ruc}"/></td><td><c:out value="${e.email}"/></td><td><span data-company-status><hp:status value="${e.status}"/></span></td><td><details><summary class="btn btn-sm btn-outline-success">Revisar solicitud / acceso</summary><form method="post" action="${pageContext.request.contextPath}/admin/companies" class="mt-2 ajax-review needs-validation" novalidate><hp:csrf/><input type="hidden" name="id" value="${e.company_id}"><label class="form-label">Decisión<select class="form-select" name="decision"><option value="active">Aprobar / activar</option><option value="inactive">Rechazar / desactivar</option><option value="suspended">Suspender</option></select></label><label class="form-label d-block">Sustento<textarea class="form-control" name="reason" required maxlength="1000" rows="3"></textarea></label><div class="ajax-feedback mb-2" role="status" aria-live="polite"></div><button class="btn btn-success">Guardar decisión</button></form></details></td></tr></c:forEach>
</tbody></table></div></section>
<section id="review-history" class="portal-panel mt-4"><h2 class="h5">Historial de decisiones</h2><p class="text-muted">Últimas 100 revisiones.</p><c:forEach var="r" items="${reviews}"><article class="border-bottom py-2"><strong><c:out value="${r.company_name}"/></strong> · <c:out value="${r.created_at}"/> · ${r.decision == 'active' ? 'Activada' : r.decision == 'suspended' ? 'Suspendida' : 'Desactivada / rechazada'}<p class="mb-1"><c:out value="${r.reason}"/></p></article></c:forEach></section>
<%@ include file="../common/footer.jsp" %>
