<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="hp" tagdir="/WEB-INF/tags" %>
<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" default="CVManager - IESP Manuel Antonio Hierro Pozo"/></title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/assets/vendor/datatables/dataTables.dataTables.min.css" rel="stylesheet">
    <!-- Estilos Propios Institucionales -->
    <link href="${pageContext.request.contextPath}/assets/css/style.css" rel="stylesheet">
</head>
<body class="${not empty sessionScope.userId ? 'portal-body' : ''}" data-context="${pageContext.request.contextPath}">

<c:if test="${not empty sessionScope.userId}">
<aside class="portal-sidebar" id="portal-sidebar">
<a class="portal-brand" href="${pageContext.request.contextPath}/home"><img src="${pageContext.request.contextPath}/assets/images/logo_hierro_pozo.png" alt="Escudo institucional"><span>MANUEL ANTONIO<br><strong>HIERRO POZO</strong><small>BOLSA LABORAL · CVMANAGER</small></span></a>
<div class="portal-welcome">Bienvenido/a<strong>${sessionScope.role == 'admin' ? 'Administrador' : sessionScope.role == 'company' ? 'Empresa' : 'Egresado'}</strong></div>
<p class="portal-menu-label">MENÚ DE NAVEGACIÓN</p>
<nav aria-label="Menú principal">
<a href="${pageContext.request.contextPath}/home"><i class="fa-solid fa-house"></i> Inicio</a>
<c:if test="${sessionScope.role == 'graduate'}">
<a href="${pageContext.request.contextPath}/graduate/profile"><i class="fa-solid fa-id-card"></i> Mi perfil</a>
<a href="${pageContext.request.contextPath}/graduate/cv"><i class="fa-solid fa-file-lines"></i> Mi currículum</a>
<a href="${pageContext.request.contextPath}/graduate/jobs"><i class="fa-solid fa-briefcase"></i> Convocatorias</a>
<a href="${pageContext.request.contextPath}/graduate/jobs?tab=applications"><i class="fa-solid fa-list-check"></i> Mis postulaciones</a>
<a href="${pageContext.request.contextPath}/graduate/requests"><i class="fa-solid fa-envelope"></i> Propuestas de contacto</a>
</c:if>
<c:if test="${sessionScope.role == 'company'}">
<a href="${pageContext.request.contextPath}/company/profile"><i class="fa-solid fa-building"></i> Mi empresa</a>
<a href="${pageContext.request.contextPath}/company/jobs"><i class="fa-solid fa-briefcase"></i> Mis convocatorias</a>
<a href="${pageContext.request.contextPath}/company/jobs?tab=applications"><i class="fa-solid fa-users"></i> Postulaciones recibidas</a>
<a href="${pageContext.request.contextPath}/company/search"><i class="fa-solid fa-search"></i> Buscar egresados</a>
<a href="${pageContext.request.contextPath}/company/favorites"><i class="fa-solid fa-star"></i> Favoritos y contactos</a>
</c:if>
<c:if test="${sessionScope.role == 'admin'}">
<a href="${pageContext.request.contextPath}/admin/dashboard"><i class="fa-solid fa-chart-pie"></i> Indicadores</a>
<a href="${pageContext.request.contextPath}/admin/companies"><i class="fa-solid fa-building"></i> Empresas y solicitudes</a>
<a href="${pageContext.request.contextPath}/admin/jobs"><i class="fa-solid fa-briefcase"></i> Convocatorias</a>
<a href="${pageContext.request.contextPath}/admin/jobs?archive=yes"><i class="fa-solid fa-box-archive"></i> Convocatorias archivadas</a>
<a href="${pageContext.request.contextPath}/admin/reports"><i class="fa-solid fa-chart-column"></i> Reportes laborales</a>
<a href="${pageContext.request.contextPath}/admin/users"><i class="fa-solid fa-users"></i> Usuarios</a>
<a href="${pageContext.request.contextPath}/admin/careers"><i class="fa-solid fa-graduation-cap"></i> Programas de estudios</a>
<a href="${pageContext.request.contextPath}/admin/audit"><i class="fa-solid fa-clock-rotate-left"></i> Auditoría</a>
</c:if>
<a href="${pageContext.request.contextPath}/account"><i class="fa-solid fa-user-gear"></i> Mi cuenta</a>
</nav></aside>
<header class="portal-topbar"><button type="button" id="sidebar-toggle" class="btn" aria-label="Alternar menú" aria-controls="portal-sidebar" aria-expanded="false"><i class="fa-solid fa-bars"></i></button><span class="portal-topbar-title">Portal de empleabilidad</span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><button class="btn btn-sm btn-outline-secondary">Cerrar sesión</button></form></header>
</c:if>
<!-- Navegación pública -->
<nav class="navbar navbar-expand-lg navbar-dark navbar-hp sticky-top ${not empty sessionScope.userId ? 'd-none' : ''}">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="${pageContext.request.contextPath}/home">
            <img src="${pageContext.request.contextPath}/assets/images/logo_hierro_pozo.png" alt="Logo IESP MAHP" style="width: 44px; height: 44px; object-fit: contain;">
            <span>
                <strong class="d-block" style="font-size: 1.15rem; line-height: 1.1;">CVManager</strong>
                <small class="d-block text-warning fw-semibold" style="font-size: 0.73rem; letter-spacing: 0.3px;">IESP Manuel Antonio Hierro Pozo</small>
            </span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="nav" class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <c:choose>
                    <c:when test="${empty sessionScope.userId}">
                        <li class="nav-item">
                            <a class="nav-link" href="${pageContext.request.contextPath}/home">
                                <i class="fa-solid fa-house me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="${pageContext.request.contextPath}/login">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Ingresar
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-warning text-dark fw-bold px-3" href="${pageContext.request.contextPath}/register">
                                <i class="fa-solid fa-user-plus me-1"></i> Registrarse
                            </a>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <c:if test="${sessionScope.role == 'graduate'}"><li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/graduate/jobs">Vacantes</a></li><li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/graduate/requests">Propuestas</a></li>
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/graduate/profile">
                                    <i class="fa-solid fa-id-card me-1"></i> Mi Perfil
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/graduate/cv">
                                    <i class="fa-solid fa-file-lines me-1"></i> Mi CV
                                </a>
                            </li>
                        </c:if>
                        <c:if test="${sessionScope.role == 'company'}"><li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/company/jobs">Vacantes</a></li><li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/company/profile">Mi empresa</a></li>
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/company/search">
                                    <i class="fa-solid fa-magnifying-glass me-1"></i> Buscar Egresados
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/company/favorites">
                                    <i class="fa-solid fa-star me-1"></i> Favoritos y Contactos
                                </a>
                            </li>
                        </c:if>
                        <c:if test="${sessionScope.role == 'admin'}">
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/admin/dashboard">
                                    <i class="fa-solid fa-chart-pie me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/admin/users">
                                    <i class="fa-solid fa-users me-1"></i> Usuarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/admin/careers">
                                    <i class="fa-solid fa-graduation-cap me-1"></i> Carreras
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/admin/audit">
                                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Auditoría
                                </a>
                            </li>
                        </c:if>
                        <li class="nav-item ms-lg-3">
                            <a class="nav-link" href="${pageContext.request.contextPath}/account">Mi cuenta</a>
                            <form method="post" action="${pageContext.request.contextPath}/logout">
<input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><button class="btn btn-outline-light btn-sm" type="submit">Cerrar sesión</button></form>
                        </li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>

<!-- Contenedor Principal de la Página -->
<main class="container py-4">

    <!-- Mensajes Globales de Alerta -->
    <c:if test="${not empty error}">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            <c:out value="${error}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </c:if>

    <c:if test="${not empty success}">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            <c:out value="${success}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </c:if>

    <c:if test="${param.ok == '1'}">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            Operación realizada correctamente.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </c:if>
