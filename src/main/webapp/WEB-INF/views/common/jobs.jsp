<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="header.jsp" %>
<div class="page-heading"><div><p class="eyebrow">BOLSA LABORAL</p><h1 class="h3">${param.tab == 'applications' ? (companyMode ? 'Postulaciones recibidas' : 'Mis postulaciones') : param.archive == 'yes' ? 'Convocatorias archivadas' : 'Convocatorias laborales'}</h1></div><c:if test="${manageMode}"><a class="btn btn-outline-secondary" href="${jobsPath}${param.archive == 'yes' ? '' : '?archive=yes'}">${param.archive == 'yes' ? 'Ver convocatorias' : 'Ver archivadas'}</a></c:if></div>
<c:if test="${param.tab != 'applications'}">
<c:if test="${manageMode}"><details class="portal-panel mb-4" ${not empty editing ? 'open' : ''}><summary class="h5 mb-0">${empty editing ? 'Nueva convocatoria' : 'Editar convocatoria'}</summary>
<form method="post" action="${jobsPath}" class="row g-3 mt-2">
<hp:csrf/><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="${editing.job_id}">
<c:if test="${adminMode and empty editing}"><div class="col-12"><label class="form-label">Empresa<select class="form-select" name="companyId" required><option value="">Seleccione una empresa activa</option><c:forEach var="e" items="${companies}"><c:if test="${e.status == 'active'}"><option value="${e.company_id}"><c:out value="${e.company_name}"/></option></c:if></c:forEach></select></label><p class="small text-muted">Esta convocatoria será administrada por usted en representación del instituto.</p></div></c:if>
<div class="col-12"><label class="form-label w-100">Título de la convocatoria<input class="form-control" name="title" maxlength="150" required value="<c:out value='${editing.title}'/>"></label></div>
<div class="col-md-6"><label class="form-label w-100">Funciones / descripción<textarea class="form-control" name="description" rows="4" maxlength="10000" required><c:out value="${editing.description}"/></textarea></label></div>
<div class="col-md-6"><label class="form-label w-100">Requisitos<textarea class="form-control" name="requirements" rows="4" maxlength="10000"><c:out value="${editing.requirements}"/></textarea></label></div>
<div class="col-md-6"><label class="form-label w-100">Beneficios<textarea class="form-control" name="benefits" rows="3" maxlength="10000"><c:out value="${editing.benefits}"/></textarea></label></div>
<div class="col-md-6"><label class="form-label w-100">Condiciones<textarea class="form-control" name="conditions" rows="3" maxlength="10000"><c:out value="${editing.conditions_text}"/></textarea></label></div>
<div class="col-md-4"><label class="form-label w-100">Lugar de trabajo<input class="form-control" name="city" maxlength="80" required value="<c:out value='${editing.city}'/>"></label></div>
<div class="col-md-4"><label class="form-label w-100">Remuneración<input class="form-control" name="salary" maxlength="100" value="<c:out value='${editing.salary}'/>"></label></div>
<div class="col-md-4"><label class="form-label w-100">Número de vacantes<input class="form-control" type="number" min="1" max="10000" name="positions" required value="${empty editing.positions ? 1 : editing.positions}"></label></div>
<div class="col-md-4"><label class="form-label w-100">Modalidad<select class="form-select" name="modality"><option value="onsite" ${editing.modality == 'onsite' ? 'selected' : ''}>Presencial</option><option value="remote" ${editing.modality == 'remote' ? 'selected' : ''}>Remoto</option><option value="hybrid" ${editing.modality == 'hybrid' ? 'selected' : ''}>Híbrido</option></select></label></div>
<div class="col-md-4"><label class="form-label w-100">Turno<input class="form-control" name="shift" maxlength="40" required value="<c:out value='${empty editing.shift_name ? "Completo" : editing.shift_name}'/>"></label></div>
<div class="col-md-4"><label class="form-label w-100">Recepción de postulaciones<select class="form-select" name="status"><option value="open" ${editing.status == 'open' ? 'selected' : ''}>Según vigencia</option><option value="closed" ${editing.status == 'closed' ? 'selected' : ''}>Cerrada</option></select></label></div>
<div class="col-md-6"><label class="form-label w-100">Fecha de inicio (opcional)<input class="form-control" type="date" name="openingDate" value="${editing.opening_date}"></label></div>
<div class="col-md-6"><label class="form-label w-100">Fecha de cierre (opcional)<input class="form-control" type="date" name="closingDate" value="${editing.closing_date}"></label></div>
<div class="col-12"><fieldset><legend class="h6">Programas de estudios destinatarios</legend><p class="small text-muted">Sin seleccionar: cualquier carrera. Puede elegir varios programas.</p><div class="row"><c:forEach var="career" items="${careers}"><c:if test="${career.active or (not empty editing and editing.careerIds.contains(career.careerId))}"><div class="col-md-6"><label class="mb-2"><input type="checkbox" name="careerId" value="${career.careerId}" ${not empty editing and editing.careerIds.contains(career.careerId) ? 'checked' : ''}> <c:out value="${career.name}"/></label></div></c:if></c:forEach></div></fieldset></div>
<div class="col-12"><label class="form-label w-100">Enlace informativo externo (opcional)<input type="url" class="form-control" name="externalUrl" maxlength="255" value="<c:out value='${editing.external_url}'/>"></label></div>
<div class="col-12"><button class="btn btn-success">Guardar convocatoria</button> <a class="btn btn-outline-secondary" href="${jobsPath}">Cancelar</a></div>
</form></details></c:if>
<c:if test="${not empty selected and empty editing}">
<section class="portal-panel mb-4"><a href="${jobsPath}" class="small">← Volver al listado</a><h2 class="h4 mt-3"><c:out value="${selected.title}"/></h2><p class="text-muted"><c:out value="${selected.company_name}"/> · <c:out value="${selected.city}"/></p>
<div class="row"><div class="col-lg-4 job-facts"><p><strong>Vacantes:</strong> <c:out value="${selected.positions}" default="1"/></p><p><strong>Turno:</strong> <c:out value="${selected.shift_name}" default="Completo"/></p><p><strong>Remuneración:</strong> <c:out value="${selected.salary}" default="A convenir"/></p><p><strong>Inicio:</strong> <c:out value="${selected.opening_date}" default="Inmediato"/></p><p><strong>Cierre:</strong> <c:out value="${selected.closing_date}" default="Sin fecha"/></p><p><strong>Programas:</strong> <c:out value="${selected.career}" default="Cualquier carrera"/></p><c:if test="${not empty selected.external_url}"><a href="<c:out value='${selected.external_url}'/>" target="_blank" rel="noopener noreferrer">Enlace informativo de la convocatoria ↗</a></c:if></div><div class="col-lg-8"><h3 class="h6">Funciones</h3><p class="preserve-lines"><c:out value="${selected.description}"/></p><h3 class="h6">Requisitos</h3><p class="preserve-lines"><c:out value="${selected.requirements}" default="No especificados"/></p><h3 class="h6">Beneficios</h3><p class="preserve-lines"><c:out value="${selected.benefits}" default="No especificados"/></p><h3 class="h6">Condiciones</h3><p class="preserve-lines"><c:out value="${selected.conditions_text}" default="No especificadas"/></p></div></div>
<hr><h3 class="h6">Documentos de la convocatoria</h3><c:if test="${empty documents}"><p class="text-muted">No hay documentos adjuntos.</p></c:if><c:forEach var="doc" items="${documents}"><div class="d-flex gap-3 align-items-center mb-2"><a href="${jobsPath}?document=${doc.document_id}"><i class="fa-regular fa-file-pdf"></i> <c:out value="${doc.title}"/></a><c:if test="${editable}"><form method="post" action="${jobsPath}" class="confirm-action"><hp:csrf/><input type="hidden" name="action" value="removeDocument"><input type="hidden" name="id" value="${selected.job_id}"><input type="hidden" name="documentId" value="${doc.document_id}"><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></c:if></div></c:forEach>
<c:if test="${editable}"><form method="post" enctype="multipart/form-data" action="${jobsPath}" class="row g-2 mt-3"><hp:csrf/><input type="hidden" name="action" value="upload"><input type="hidden" name="id" value="${selected.job_id}"><div class="col-md-5"><label class="form-label w-100">Título del documento<input name="title" class="form-control" required maxlength="150"></label></div><div class="col-md-5"><label class="form-label w-100">PDF (máximo 5 MB)<input type="file" class="form-control" name="file" accept="application/pdf" required></label></div><div class="col-md-2 align-self-end pb-2"><button class="btn btn-success">Adjuntar</button></div></form></c:if>
</section></c:if>
<section class="portal-panel"><form method="get" action="${jobsPath}" class="row g-3 mb-4"><input type="hidden" name="archive" value="<c:out value='${param.archive}'/>"><div class="col-md-4"><label class="form-label" for="stage">Filtrar por estado</label><select class="form-select" id="stage" name="stage"><option value="">Todos</option><option value="upcoming" ${param.stage == 'upcoming' ? 'selected' : ''}>Por comenzar</option><option value="ongoing" ${param.stage == 'ongoing' ? 'selected' : ''}>En proceso</option><option value="finished" ${param.stage == 'finished' ? 'selected' : ''}>Finalizado</option></select></div><div class="col-md-6"><label class="form-label" for="job-query">Buscar</label><input id="job-query" class="form-control" name="q" placeholder="Puesto, empresa o descripción" value="<c:out value='${param.q}'/>"></div><div class="col-md-2 align-self-end"><button class="btn btn-success">Filtrar</button></div></form>
<div class="table-responsive"><table class="table table-bordered table-striped portal-table" data-local-table><thead><tr><th>N.º</th><th>Empresa</th><th>Título de la convocatoria</th><th>Lugar / modalidad</th><th>Turno / salario</th><th>Fecha fin</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="j" items="${jobs}"><tr><td>${j.job_id}</td><td><c:out value="${j.company_name}"/><c:if test="${manageMode}"><small class="d-block text-muted">${empty j.managed_by ? 'Administra: empresa' : 'Administra: instituto'}</small></c:if></td><td><strong><c:out value="${j.title}"/></strong><small class="d-block text-muted"><c:out value="${j.career}" default="Cualquier carrera"/></small></td><td><c:out value="${j.city}"/><small class="d-block">${j.modality == 'remote' ? 'Remoto' : j.modality == 'hybrid' ? 'Híbrido' : 'Presencial'}</small></td><td><c:out value="${j.shift_name}" default="Completo"/><small class="d-block"><c:out value="${j.salary}"/></small></td><td><c:out value="${j.closing_date}" default="Sin fecha"/></td><td><hp:status value="${j.stage}"/></td><td><div class="job-actions"><a class="btn btn-success btn-sm" href="${jobsPath}?view=${j.job_id}" aria-label="Ver convocatoria ${j.job_id}"><i class="fa-solid fa-eye"></i> Ver</a>
<c:if test="${manageMode}"><c:if test="${adminMode ? j.managed_by == sessionScope.userId : empty j.managed_by}"><a class="btn btn-outline-secondary btn-sm" href="${jobsPath}?edit=${j.job_id}">Editar</a></c:if><c:if test="${adminMode or empty j.managed_by}"><form method="post" action="${jobsPath}"><hp:csrf/><input type="hidden" name="action" value="archive"><input type="hidden" name="id" value="${j.job_id}"><input type="hidden" name="archived" value="${j.stage == 'archived' ? 'no' : 'yes'}"><button class="btn btn-outline-secondary btn-sm">${j.stage == 'archived' ? 'Restaurar' : 'Archivar'}</button></form></c:if></c:if>
<c:if test="${not manageMode and j.stage == 'ongoing'}"><c:set var="alreadyApplied" value="false"/><c:forEach var="a" items="${applications}"><c:if test="${a.job_id == j.job_id}"><c:set var="alreadyApplied" value="true"/></c:if></c:forEach><c:choose><c:when test="${alreadyApplied}"><small>Postulación registrada</small></c:when><c:otherwise><details><summary class="btn btn-outline-success btn-sm">Quiero postular</summary><form method="post" action="${jobsPath}" class="application-form mt-2"><hp:csrf/><input type="hidden" name="action" value="apply"><input type="hidden" name="id" value="${j.job_id}"><label class="form-label">Presentación<textarea class="form-control" name="message" maxlength="5000" rows="3" required></textarea></label><label class="small d-block mb-2"><input type="checkbox" name="consent" value="yes" required> Compartir mi CV, PDF y contacto con esta empresa aunque mi perfil sea privado.</label><button class="btn btn-success btn-sm">Enviar postulación</button></form></details></c:otherwise></c:choose></c:if>
</div></td></tr></c:forEach></tbody></table></div><c:if test="${empty jobs}"><p class="alert alert-info">No hay convocatorias para estos filtros.</p></c:if></section>
</c:if>
<%@ include file="applications.jspf" %>
<%@ include file="footer.jsp" %>
