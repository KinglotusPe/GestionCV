<c:if test="${not adminMode}">
    <section id="applications" class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h4 mb-0 fw-bold">
                <i class="fa-solid fa-file-signature text-success me-2"></i>${companyMode ? 'Postulaciones Recibidas' : 'Mis Postulaciones'}
            </h3>
            <span class="badge bg-secondary">${not empty applications ? applications.size() : 0} en total</span>
        </div>

        <c:if test="${empty applications}">
            <div class="alert alert-light border p-4 text-center">
                <i class="fa-regular fa-folder-open fa-2x text-muted mb-2 d-block"></i>
                <p class="text-muted mb-0">Todavía no hay postulaciones registradas en este apartado.</p>
            </div>
        </c:if>

        <c:forEach var="a" items="${applications}">
            <article class="card p-4 mb-3 border shadow-sm ${a.status == 'accepted' ? 'border-success' : ''}">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <h4 class="h5 fw-bold mb-1 text-dark">
                            <c:out value="${a.title}"/> 
                            <span class="text-muted fw-normal">· <c:out value="${a.company_name}"/></span>
                        </h4>
                        <div class="small text-muted">
                            <i class="fa-regular fa-clock me-1"></i>Postulado el: <c:out value="${a.applied_at}"/>
                        </div>
                    </div>
                    <div>
                        <c:choose>
                            <c:when test="${a.status == 'POSTULADO' or a.status == 'pending'}">
                                <span class="badge bg-warning text-dark px-3 py-2"><i class="fa-solid fa-hourglass-half me-1"></i> Postulado</span>
                            </c:when>
                            <c:when test="${a.status == 'EN_REVISION' or a.status == 'reviewing'}">
                                <span class="badge bg-info text-dark px-3 py-2"><i class="fa-solid fa-spinner me-1"></i> En revisión</span>
                            </c:when>
                            <c:when test="${a.status == 'PRESELECCIONADO'}">
                                <span class="badge bg-primary px-3 py-2"><i class="fa-solid fa-star me-1"></i> Preseleccionado</span>
                            </c:when>
                            <c:when test="${a.status == 'ENTREVISTA'}">
                                <span class="badge text-white px-3 py-2" style="background-color: #6f42c1;"><i class="fa-solid fa-calendar-check me-1"></i> Convocado a Entrevista</span>
                            </c:when>
                            <c:when test="${a.status == 'SELECCIONADO' or a.status == 'accepted'}">
                                <span class="badge bg-success px-3 py-2"><i class="fa-solid fa-circle-check me-1"></i> ¡Seleccionado!</span>
                            </c:when>
                            <c:when test="${a.status == 'NO_SELECCIONADO' or a.status == 'rejected'}">
                                <span class="badge bg-danger px-3 py-2"><i class="fa-solid fa-ban me-1"></i> No seleccionado</span>
                            </c:when>
                            <c:otherwise>
                                <span class="badge bg-secondary px-3 py-2"><i class="fa-solid fa-arrow-rotate-left me-1"></i> Retirada</span>
                            </c:otherwise>
                        </c:choose>
                    </div>
                </div>

                <!-- Notificaciones en tarjeta para el estudiante/egresado segun el estado -->
                <c:if test="${not companyMode}">
                    <c:choose>
                        <c:when test="${a.status == 'SELECCIONADO' or a.status == 'accepted'}">
                            <div class="alert alert-success border-success mt-2 mb-3 p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fa-solid fa-award fa-2x text-success me-3"></i>
                                    <div>
                                        <h5 class="alert-heading mb-0 fw-bold">¡Felicitaciones! Has sido seleccionado para este puesto</h5>
                                        <small>La empresa ha aprobado tu postulación. Comunícate directamente con ellos para coordinar tu incorporación.</small>
                                    </div>
                                </div>
                                <hr class="my-2">
                                <div class="row g-2 align-items-center">
                                    <c:if test="${not empty a.company_email}">
                                        <div class="col-auto">
                                            <a href="mailto:${a.company_email}" class="btn btn-sm btn-outline-success">
                                                <i class="fa-solid fa-envelope me-1"></i> <c:out value="${a.company_email}"/>
                                            </a>
                                        </div>
                                    </c:if>
                                    <c:if test="${not empty a.company_phone}">
                                        <div class="col-auto">
                                            <a href="https://wa.me/51${a.company_phone}" target="_blank" class="btn btn-sm btn-success">
                                                <i class="fa-brands fa-whatsapp me-1"></i> WhatsApp: <c:out value="${a.company_phone}"/>
                                            </a>
                                        </div>
                                    </c:if>
                                    <c:if test="${not empty a.job_city}">
                                        <div class="col-auto text-muted small">
                                            <i class="fa-solid fa-location-dot me-1"></i> Sede / Ciudad: <c:out value="${a.job_city}"/>
                                        </div>
                                    </c:if>
                                </div>
                            </div>
                        </c:when>
                        <c:when test="${a.status == 'ENTREVISTA'}">
                            <div class="alert alert-primary border-primary mt-2 mb-3 p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fa-solid fa-calendar-check fa-2x text-primary me-3"></i>
                                    <div>
                                        <h5 class="alert-heading mb-0 fw-bold">¡Has sido invitado a una entrevista laboral!</h5>
                                        <small>La empresa desea entrevistarte. Mantente atento a tu correo/WhatsApp o comunícate a través de los canales proporcionados.</small>
                                    </div>
                                </div>
                                <hr class="my-2">
                                <div class="row g-2 align-items-center">
                                    <c:if test="${not empty a.company_email}">
                                        <div class="col-auto">
                                            <a href="mailto:${a.company_email}" class="btn btn-sm btn-outline-primary">
                                                <i class="fa-solid fa-envelope me-1"></i> <c:out value="${a.company_email}"/>
                                            </a>
                                        </div>
                                    </c:if>
                                    <c:if test="${not empty a.company_phone}">
                                        <div class="col-auto">
                                            <a href="https://wa.me/51${a.company_phone}" target="_blank" class="btn btn-sm btn-primary">
                                                <i class="fa-brands fa-whatsapp me-1"></i> WhatsApp: <c:out value="${a.company_phone}"/>
                                            </a>
                                        </div>
                                    </c:if>
                                </div>
                            </div>
                        </c:when>
                        <c:when test="${a.status == 'PRESELECCIONADO'}">
                            <div class="alert alert-info border-info mt-2 mb-3 p-3">
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-star fa-2x text-info me-3"></i>
                                    <div>
                                        <h5 class="alert-heading mb-0 fw-bold">Postulación Preseleccionada</h5>
                                        <small>Tu perfil cumplió con los requisitos preliminares de la empresa y se encuentra en la terna final de evaluación.</small>
                                    </div>
                                </div>
                            </div>
                        </c:when>
                    </c:choose>
                </c:if>

                <!-- Si el usuario es empresa, mostramos los datos del postulante con privacidad estricta -->
                <c:if test="${companyMode}">
                    <div class="p-3 mb-2 bg-light rounded border">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div>
                                <h5 class="h6 mb-1 text-dark">
                                    <i class="fa-solid fa-user me-1 text-secondary"></i> <strong><c:out value="${a.first_name} ${a.last_name}"/></strong>
                                </h5>
                                <c:if test="${not empty a.career_name}">
                                    <span class="badge bg-white text-dark border me-2">
                                        <i class="fa-solid fa-graduation-cap me-1 text-success"></i> <c:out value="${a.career_name}"/>
                                    </span>
                                </c:if>
                            </div>
                            <div>
                                <c:if test="${a.status != 'withdrawn' and a.status != 'RETIRADO' and not empty a.cv_id}">
                                    <a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/company/cv?id=${a.cv_id}">
                                        <i class="fa-regular fa-file-pdf me-1"></i> Ver CV completo
                                    </a>
                                </c:if>
                            </div>
                        </div>

                        <c:if test="${not empty a.professional_summary}">
                            <div class="p-2 mb-2 bg-white rounded border-start border-3 border-success small text-muted">
                                <strong>Perfil:</strong> <c:out value="${a.professional_summary}"/>
                            </div>
                        </c:if>

                        <div class="mt-2 pt-2 border-top d-flex flex-wrap align-items-center gap-3 small">
                            <c:choose>
                                <c:when test="${not empty a.email or not empty a.phone}">
                                    <div class="text-success fw-bold"><i class="fa-solid fa-lock-open me-1"></i> Contacto habilitado:</div>
                                    <c:if test="${not empty a.email}">
                                        <div><i class="fa-solid fa-envelope me-1 text-primary"></i> <a href="mailto:${a.email}"><c:out value="${a.email}"/></a></div>
                                    </c:if>
                                    <c:if test="${not empty a.phone}">
                                        <div>
                                            <i class="fa-solid fa-phone me-1 text-success"></i> <a href="tel:${a.phone}"><c:out value="${a.phone}"/></a>
                                            <a href="https://wa.me/51${a.phone}" target="_blank" class="badge bg-success text-decoration-none ms-1"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
                                        </div>
                                    </c:if>
                                </c:when>
                                <c:otherwise>
                                    <span class="text-muted"><i class="fa-solid fa-lock me-1"></i> Contacto protegido por privacidad (disponible al pasar a Preseleccionado, Entrevista o Seleccionado).</span>
                                </c:otherwise>
                            </c:choose>
                        </div>
                    </div>
                </c:if>

                <!-- Mensaje adjunto a la postulacion -->
                <c:if test="${not empty a.message}">
                    <div class="mb-3 text-secondary p-2 bg-white rounded border-start border-3 border-secondary">
                        <small class="fw-bold d-block text-dark mb-1">Mensaje de presentación:</small>
                        <span style="white-space:pre-wrap;"><c:out value="${a.message}"/></span>
                    </div>
                </c:if>

                <!-- Acciones segun rol -->
                <c:if test="${a.status != 'withdrawn' and a.status != 'RETIRADO'}">
                    <form method="post" action="${jobsPath}" class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top">
                        <hp:csrf/>
                        <input type="hidden" name="action" value="respond">
                        <input type="hidden" name="id" value="${a.application_id}">
                        
                        <c:choose>
                            <c:when test="${companyMode}">
                                <label class="small fw-bold text-muted me-2">Estado del candidato:</label>
                                <select class="form-select form-select-sm w-auto" name="status">
                                    <option value="POSTULADO" ${a.status == 'POSTULADO' or a.status == 'pending' ? 'selected' : ''}>Postulado</option>
                                    <option value="EN_REVISION" ${a.status == 'EN_REVISION' or a.status == 'reviewing' ? 'selected' : ''}>En revisión</option>
                                    <option value="PRESELECCIONADO" ${a.status == 'PRESELECCIONADO' ? 'selected' : ''}>Preseleccionado</option>
                                    <option value="ENTREVISTA" ${a.status == 'ENTREVISTA' ? 'selected' : ''}>Entrevista</option>
                                    <option value="SELECCIONADO" ${a.status == 'SELECCIONADO' or a.status == 'accepted' ? 'selected' : ''}>Seleccionado / Contratado</option>
                                    <option value="NO_SELECCIONADO" ${a.status == 'NO_SELECCIONADO' or a.status == 'rejected' ? 'selected' : ''}>No seleccionado</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="fa-solid fa-check me-1"></i> Actualizar estado
                                </button>
                            </c:when>
                            <c:otherwise>
                                <c:if test="${a.status != 'SELECCIONADO' and a.status != 'accepted'}">
                                    <button class="btn btn-sm btn-outline-danger" name="status" value="RETIRADO" onclick="return confirm('¿Estás seguro de que deseas retirar tu postulación?');">
                                        <i class="fa-solid fa-trash me-1"></i> Retirar postulación
                                    </button>
                                </c:if>
                            </c:otherwise>
                        </c:choose>
                    </form>
                </c:if>
            </article>
        </c:forEach>
    </section>
</c:if>